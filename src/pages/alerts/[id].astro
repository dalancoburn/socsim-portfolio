---
// Alert write-ups became investigations (schema v3). Old links such as
// /alerts/ALT-001/ — shared on LinkedIn, in CVs — redirect to the new page.
import type { GetStaticPaths } from 'astro';
import { portfolio, routable } from '../../utils/portfolio';

export const getStaticPaths = (() =>
  routable(portfolio.investigations).map((inv) => ({
    params: { id: String(inv.id).trim() },
  }))
) satisfies GetStaticPaths;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/investigations/${encodeURIComponent(Astro.params.id!)}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This investigation has moved: <a href={target}>{target}</a></p>
  </body>
</html>
